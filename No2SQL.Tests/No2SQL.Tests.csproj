<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Automated tests (xUnit). The HTTP tests run the real HTTP-mode services and pipeline of No2SQL
    on an in-memory server (WebApplicationFactory), so no port is opened and no MongoDB is needed.
    Run with: dotnet test No2SQL.sln -c Release
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- No2SQL is built as a self-contained tool; the tests only load its assembly, they do not run its executable. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!--
      xunit.v3.mtp-off runs under VSTest, so a plain "dotnet test" works on every .NET 10 SDK band
      without opting the whole repository into Microsoft.Testing.Platform through global.json.
    -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\No2SQL\No2SQL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
