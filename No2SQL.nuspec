    <file src="artifacts/publish/win-x64/No2SQL.exe" target="tools/win-x64/No2SQL.exe" />
    <file src="artifacts/publish/linux-x64/No2SQL" target="tools/linux-x64/No2SQL" />
    <file src="artifacts/publish/osx-arm64/No2SQL" target="tools/osx-arm64/No2SQL" />
  </files>
</package>
