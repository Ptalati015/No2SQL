<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Packaged as a .NET tool so the .NET 10 SDK can run it directly with
      `dnx No2SQL@<version>`, which is how MCP clients launch NuGet-hosted servers.
      With PackAsTool + RuntimeIdentifiers the SDK produces one small primary package
      (No2SQL, type DotnetTool;McpServer, carrying .mcp/server.json and the RID list) and
      one self-contained single-file package per RID (No2SQL.<rid>, type DotnetToolRidPackage).
      dnx picks the RID package for the current machine, so users need the SDK for dnx itself
      but no separate .NET runtime. The csproj is the only packaging source of truth.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>No2SQL</ToolCommandName>
    <PackageType>McpServer</PackageType>

    <!-- NuGet package metadata -->
    <PackageId>No2SQL</PackageId>
    <PackageVersion>1.0.3</PackageVersion>
    <!-- Assembly/file/informational version follow the package version so MCP initialize reports the real number -->
    <Version>$(PackageVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>AI; MCP; server; stdio</PackageTags>
    <Description>No2SQL MCP server that transforms MongoDB schemas into SQL schema scripts and ER diagrams.</Description>
    <Authors>Preet Talati</Authors>
    <Company>No2SQL</Company>
    <PackageProjectUrl>https://github.com/Ptalati015/No2SQL</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ptalati015/No2SQL</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Self-contained single-file binaries, one RID package each -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <!-- Package hygiene: validate packages on pack (symbols are dropped for Release in Directory.Build.props) -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Deterministic, source-link-friendly builds in CI -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="..\NOTICE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="..\TRADEMARK.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\No2SQL.Core\No2SQL.Core.csproj" />
    <ProjectReference Include="..\No2SQL.Sql\No2SQL.Sql.csproj" />
    <ProjectReference Include="..\No2SQL.Visuals\No2SQL.Visuals.csproj" />
    <ProjectReference Include="..\No2SQL.Utils\No2SQL.Utils.csproj" />
  </ItemGroup>

</Project>
