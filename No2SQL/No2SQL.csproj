<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Packaged as a .NET tool so the .NET 10 SDK can run it directly with
      `dnx No2SQL@<version>`, which is how MCP clients launch NuGet-hosted servers.
      With PackAsTool + RuntimeIdentifiers the SDK produces one small primary package
      (No2SQL, type DotnetTool;McpServer, carrying .mcp/server.json and the RID list) and
      one self-contained single-file package per RID (No2SQL.<rid>, type DotnetToolRidPackage).
      dnx picks the RID package for the current machine, so users need the SDK for dnx itself
      but no separate .NET runtime. The csproj is the only packaging source of truth.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>No2SQL</ToolCommandName>
    <!--
      McpServer goes on the primary package only. The SDK packs each RID package with
      RuntimeIdentifier set, and nuget.org rejects a package that has McpServer without
      DotnetTool (RID packages are DotnetToolRidPackage), so the condition must stay.
    -->
    <PackageType Condition="'$(RuntimeIdentifier)' == ''">McpServer</PackageType>

    <!-- NuGet package metadata -->
    <PackageId>No2SQL</PackageId>
    <PackageVersion>1.1.2</PackageVersion>
    <!-- Assembly/file/informational version follow the package version so MCP initialize reports the real number -->
    <Version>$(PackageVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>AI; MCP; server; stdio</PackageTags>
    <Description>No2SQL MCP server that transforms MongoDB schemas into SQL schema scripts and ER diagrams.</Description>
    <Authors>Preet Talati</Authors>
    <Company>No2SQL</Company>
    <PackageProjectUrl>https://github.com/Ptalati015/No2SQL</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ptalati015/No2SQL</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Self-contained single-file binaries, one RID package each -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <!-- Package hygiene: validate packages on pack (symbols are dropped for Release in Directory.Build.props) -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!--
    Container image (P2-8). Build it with
      dotnet publish No2SQL/No2SQL.csproj -c Release -t:PublishContainer -p:No2SqlContainer=true
    No2SqlContainer=true switches this project from the self-contained single-file exe (zips and dnx)
    to a framework-dependent app on the chiseled ASP.NET Core base, because the SDK can only build a
    multi-arch image framework-dependent. Result: linux-x64 and linux-arm64 in one image index,
    no shell or package manager, the non-root "app" user (UID 1654), the base image's .NET runtime
    (the release workflow gates it at 10.0.15 or later).
    The image starts HTTP mode on 0.0.0.0:8787 and carries no auth and no secret. Until it gets
    NO2SQL_HTTP_TOKEN or an OAuth setting at run time, HTTP mode refuses to start on 0.0.0.0.
    "docker run -i -e NO2SQL_TRANSPORT=stdio" gives a stdio server instead.
    The release workflow sets ContainerRegistry=ghcr.io and pushes.
  -->
  <PropertyGroup Label="Container image" Condition="'$(No2SqlContainer)' == 'true'">
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <UseCurrentRuntimeIdentifier>false</UseCurrentRuntimeIdentifier>
    <!-- Lets the SDK add the org.opencontainers.image.source and .revision labels. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Label="Container image">
    <ContainerRepository>ptalati015/no2sql</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra</ContainerBaseImage>
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>
    <ContainerImageTags>$(PackageVersion);latest</ContainerImageTags>
    <ContainerUser>app</ContainerUser>
    <ContainerTitle>No2SQL</ContainerTitle>
  </PropertyGroup>

  <ItemGroup Label="Container image">
    <ContainerPort Include="8787" Type="tcp" />
    <ContainerEnvironmentVariable Include="NO2SQL_TRANSPORT" Value="http" />
    <ContainerEnvironmentVariable Include="NO2SQL_HTTP_URLS" Value="http://0.0.0.0:8787" />
    <!-- No debugger, profiler or EventPipe IPC: nothing to attach to, and no files in /tmp, so a
         read-only root filesystem works without a tmpfs. -->
    <ContainerEnvironmentVariable Include="DOTNET_EnableDiagnostics" Value="0" />
    <!-- The built-in sign-in's state (P2-5) goes to the one writable path, the /data volume. -->
    <ContainerEnvironmentVariable Include="NO2SQL_DATA_DIR" Value="/data" />
    <ContainerLabel Include="io.modelcontextprotocol.server.name" Value="io.github.Ptalati015/no2sql" />
  </ItemGroup>

  <!--
    Workaround for an SDK container bug (seen on 10.0.115): a multi-arch publish hands labels and
    environment variables to each per-arch build as "name:value" strings, and the per-arch build
    splits them at every colon and keeps only the first two parts. NO2SQL_HTTP_URLS became "http"
    and every URL or timestamp label was cut. This rebuilds both lists from the same strings,
    splitting at the first colon only. It does nothing outside a multi-arch publish.
  -->
  <Target Name="_No2SqlFixColonSplitContainerItems" AfterTargets="_ParseItemsForPublishingSingleContainer">
    <ItemGroup Condition="@(_ParsedContainerLabel->Count()) > 0">
      <ContainerLabel Remove="@(ContainerLabel)" />
      <ContainerLabel Include="$([System.String]::Copy('%(_ParsedContainerLabel.Identity)').Split(':')[0])"
                      Value="$([System.String]::Copy('%(_ParsedContainerLabel.Identity)').Substring($([System.String]::Copy('%(_ParsedContainerLabel.Identity)').IndexOf(':'))).Substring(1))" />
    </ItemGroup>
    <ItemGroup Condition="@(_ParsedContainerEnvironmentVariables->Count()) > 0">
      <ContainerEnvironmentVariables Remove="@(ContainerEnvironmentVariables)" />
      <ContainerEnvironmentVariables Include="$([System.String]::Copy('%(_ParsedContainerEnvironmentVariables.Identity)').Split(':')[0])"
                                     Value="$([System.String]::Copy('%(_ParsedContainerEnvironmentVariables.Identity)').Substring($([System.String]::Copy('%(_ParsedContainerEnvironmentVariables.Identity)').IndexOf(':'))).Substring(1))" />
    </ItemGroup>
  </Target>

  <!-- Deterministic, source-link-friendly builds in CI -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="..\NOTICE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="..\TRADEMARK.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!--
    HTTP mode (opt-in, see Hosting/HttpServer.cs) runs on ASP.NET Core, so the self-contained build
    carries the Microsoft.AspNetCore.App shared framework. That framework also supplies
    Microsoft.Extensions.Hosting and the rest of Microsoft.Extensions.* for the stdio host, at the
    same patch level as the .NET runtime, so there is no separate package pin for them.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    ASP.NET Core's Windows runtime pack carries aspnetcorev2_inprocess.dll, the IIS in-process handler.
    No2SQL never runs inside IIS, so the file is dropped from the deps file and from publish: otherwise
    it would sit next to No2SQL.exe in the win RID packages, or be bundled into the zip exe and
    extracted to a temp folder on first start.
  -->
  <Target Name="DropIisHandlerFromDeps" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <RuntimePackAsset Remove="@(RuntimePackAsset)" Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'" />
    </ItemGroup>
  </Target>
  <Target Name="DropIisHandlerFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\No2SQL.Core\No2SQL.Core.csproj" />
    <ProjectReference Include="..\No2SQL.Sql\No2SQL.Sql.csproj" />
    <ProjectReference Include="..\No2SQL.Visuals\No2SQL.Visuals.csproj" />
    <ProjectReference Include="..\No2SQL.Utils\No2SQL.Utils.csproj" />
  </ItemGroup>

</Project>
