# Copy to no2sql.env, chmod 600, and fill in ONE of the two auth options. Never commit no2sql.env.
#
# Option 1: a bearer token, at least 32 bytes. Generate one with:  openssl rand -base64 48
NO2SQL_HTTP_TOKEN=
#
# Option 2: an external identity provider (OAuth). Leave NO2SQL_HTTP_TOKEN empty and set:
# NO2SQL_OAUTH_AUTHORITY=https://login.example.com/
